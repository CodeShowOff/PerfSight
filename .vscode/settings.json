{
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "editor.quickSuggestions": {
    "strings": true
  },
  "tailwindCSS.experimental.classRegex": [
    ["className\\s*[=:]\\s*['\"`]([^'\"`]*)['\"`]", "([^\\s]+)"]
  ],
  "typescript.tsserver.exclude": [
    "**/node_modules/**"
  ],
  "javascript.tsserver.exclude": [
    "**/node_modules/**"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/node_modules": true
  }
}
